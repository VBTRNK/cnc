{
  "name": "cnc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/agent-hooks.test.cjs",
    "verify": "npm run typecheck && npm test && vite build",
    "strategies": "node scripts/strategies.ts",
    "browser-check": "node scripts/browser-check.mjs",
    "replay": "vitest run tests/chapter-replay.test.ts"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
