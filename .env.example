# Documented shape only: real values live in .env.local (ignored) and in the
# Vercel project's environment variables. Never commit a value.

# Browser-safe: Vite builds VITE_ variables into the bundle. Without them the
# build is guest-only and offers no cloud save. The URL must be a bare origin
# listed in connect-src in vercel.json. A local test server (localhost) is
# accepted by the dev server, or by a build run with CNC_LOCAL_CLOUD=1.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# This game has no server, so it never needs the secret key. Never give a
# secret a VITE_ prefix: it would ship to every browser.
